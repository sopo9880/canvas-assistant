{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Canvas Assistant",
  "version": "0.2.0",
  "identifier": "com.sopo9880.canvasassistant",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Canvas Assistant",
        "width": 1200,
        "height": 800,
        "minWidth": 850,
        "minHeight": 600,
        "backgroundColor": "#101723",
        "label": "main"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: https:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "languages": [
          "Korean",
          "English"
        ],
        "installMode": "currentUser"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    },
    "publisher": "sopo9880",
    "shortDescription": "Canvas LMS 학습 비서",
    "longDescription": "Canvas LMS와 Codex를 연결한 Windows 개인 학습 비서",
    "resources": {
      "resources/codex/codex.exe": "codex/codex.exe"
    }
  }
}