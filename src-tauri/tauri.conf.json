{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Canvas Assistant",
  "version": "0.1.0",
  "identifier": "com.sopo9880.canvasassistant",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Canvas Assistant",
        "width": 1200,
        "height": 800,
        "minWidth": 850,
        "minHeight": 600,
        "backgroundColor": "#101723"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false
      }
    }
  }
}
