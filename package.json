{
  "name": "canvas-assistant",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "test": "node --test tests/*.test.mjs",
    "tauri": "tauri",
    "icons": "tauri icon assets/logo-1024.png -o src-tauri/icons",
    "ui:preview": "vite --config preview/vite.config.ts",
    "build:win-cross": "bash scripts/build-windows-on-linux.sh",
    "fetch:codex": "node scripts/fetch-codex.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.0",
    "@tauri-apps/plugin-autostart": "^2.7.0",
    "@tauri-apps/plugin-notification": "^2.8.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "codexVersion": "0.165.0"
}
